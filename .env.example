# Set SHARLEY_OFFLINE=1 to force every local fallback.
SHARLEY_OFFLINE=0
# Verifier brain (Meta). Model id and base URL come from dev.meta.ai/docs/models.
META_API_KEY=
META_BASE_URL=
META_MODEL=
# Fallback verifier
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Implementer + sandbox (Gemini)
GEMINI_API_KEY=
# Long-context intake (SubQ Snap 1.1)
SUBQ_API_KEY=
SUBQ_BASE_URL=
SUBQ_MODEL=
# Local OpenAI-compatible endpoint (vLLM / Ollama over Tailscale)
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# Storage
MONGODB_URI=
SHARLEY_HOME=.sharley
# Hard spend cap in USD across all paid providers (persisted in SHARLEY_HOME/ledger.json)
SHARLEY_BUDGET_USD=15
# Optional Meta price overrides (USD per million tokens); unknown models are priced conservatively
META_PRICE_IN=
META_PRICE_OUT=
